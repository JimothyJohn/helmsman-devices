helmsman-device 1
# Murrelektronik IMPACT67 E DIO8 (DIO8) (art. no. 55089): 16 DIO (pin 4 and pin 2 of 8 M12 ports, each an input or an output, 1.6 A).
# EtherNet/IP only. Not checked on a unit; where each bit comes from is in README.md.
vendor Murrelektronik
model  IMPACT67 E DIO8 (DIO8)
kind   remote-io

# One Class 1 exclusive owner, written out from the handbook (no EDS read).
# RPI: 5 ms at least, 10 ms by default, tested below 10 ms only (pp. 21, 58);
# the 1 s ceiling is ours, the handbook gives none.
transport enip-io config=110 o2t=35:2 t2o=117:8 rpi_ms=10 cycle_ms=10..1000

# inputs, input byte 0 (pin 4) and 1 (pin 2): a channel set to input
in  DI-00               bool enip-io=in:0.0
in  DI-01               bool enip-io=in:0.1
in  DI-02               bool enip-io=in:0.2
in  DI-03               bool enip-io=in:0.3
in  DI-04               bool enip-io=in:0.4
in  DI-05               bool enip-io=in:0.5
in  DI-06               bool enip-io=in:0.6
in  DI-07               bool enip-io=in:0.7
in  DI-10               bool enip-io=in:1.0
in  DI-11               bool enip-io=in:1.1
in  DI-12               bool enip-io=in:1.2
in  DI-13               bool enip-io=in:1.3
in  DI-14               bool enip-io=in:1.4
in  DI-15               bool enip-io=in:1.5
in  DI-16               bool enip-io=in:1.6
in  DI-17               bool enip-io=in:1.7

# supply diagnosis, input byte 2 (p. 74)
in  UA-missing          bool enip-io=in:2.1
in  US-low              bool enip-io=in:2.2
in  UA-low              bool enip-io=in:2.3

# sensor supply short-circuit per M12 port, input byte 3
in  port-0-sensor-short bool enip-io=in:3.0
in  port-1-sensor-short bool enip-io=in:3.1
in  port-2-sensor-short bool enip-io=in:3.2
in  port-3-sensor-short bool enip-io=in:3.3
in  port-4-sensor-short bool enip-io=in:3.4
in  port-5-sensor-short bool enip-io=in:3.5
in  port-6-sensor-short bool enip-io=in:3.6
in  port-7-sensor-short bool enip-io=in:3.7

# output overload per channel, input bytes 4 (pin 4) and 5 (pin 2)
in  DO-00-overload      bool enip-io=in:4.0
in  DO-01-overload      bool enip-io=in:4.1
in  DO-02-overload      bool enip-io=in:4.2
in  DO-03-overload      bool enip-io=in:4.3
in  DO-04-overload      bool enip-io=in:4.4
in  DO-05-overload      bool enip-io=in:4.5
in  DO-06-overload      bool enip-io=in:4.6
in  DO-07-overload      bool enip-io=in:4.7
in  DO-10-overload      bool enip-io=in:5.0
in  DO-11-overload      bool enip-io=in:5.1
in  DO-12-overload      bool enip-io=in:5.2
in  DO-13-overload      bool enip-io=in:5.3
in  DO-14-overload      bool enip-io=in:5.4
in  DO-15-overload      bool enip-io=in:5.5
in  DO-16-overload      bool enip-io=in:5.6
in  DO-17-overload      bool enip-io=in:5.7

# output warning per channel, input bytes 6 (pin 4) and 7 (pin 2)
in  DO-00-warning       bool enip-io=in:6.0
in  DO-01-warning       bool enip-io=in:6.1
in  DO-02-warning       bool enip-io=in:6.2
in  DO-03-warning       bool enip-io=in:6.3
in  DO-04-warning       bool enip-io=in:6.4
in  DO-05-warning       bool enip-io=in:6.5
in  DO-06-warning       bool enip-io=in:6.6
in  DO-07-warning       bool enip-io=in:6.7
in  DO-10-warning       bool enip-io=in:7.0
in  DO-11-warning       bool enip-io=in:7.1
in  DO-12-warning       bool enip-io=in:7.2
in  DO-13-warning       bool enip-io=in:7.3
in  DO-14-warning       bool enip-io=in:7.4
in  DO-15-warning       bool enip-io=in:7.5
in  DO-16-warning       bool enip-io=in:7.6
in  DO-17-warning       bool enip-io=in:7.7

# outputs, output byte 0 (pin 4) and 1 (pin 2): a channel set to output
out DO-00               bool safe=false enip-io=out:0.0
out DO-01               bool safe=false enip-io=out:0.1
out DO-02               bool safe=false enip-io=out:0.2
out DO-03               bool safe=false enip-io=out:0.3
out DO-04               bool safe=false enip-io=out:0.4
out DO-05               bool safe=false enip-io=out:0.5
out DO-06               bool safe=false enip-io=out:0.6
out DO-07               bool safe=false enip-io=out:0.7
out DO-10               bool safe=false enip-io=out:1.0
out DO-11               bool safe=false enip-io=out:1.1
out DO-12               bool safe=false enip-io=out:1.2
out DO-13               bool safe=false enip-io=out:1.3
out DO-14               bool safe=false enip-io=out:1.4
out DO-15               bool safe=false enip-io=out:1.5
out DO-16               bool safe=false enip-io=out:1.6
out DO-17               bool safe=false enip-io=out:1.7
