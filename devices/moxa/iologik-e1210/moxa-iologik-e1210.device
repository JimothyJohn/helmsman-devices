helmsman-device 1
# Moxa ioLogik E1210: 16 DI channels, each a digital input or a counter.
# Not checked on a unit; where each address comes from is in README.md.
vendor Moxa
model  ioLogik E1210
kind   remote-io

# Modbus TCP only: this model's EDS has not been read, so its EtherNet/IP
# connection is not recorded (README.md).
transport modbus-tcp unit=1

# digital inputs: discrete inputs 0..15
in  DI-00       bool modbus-tcp=di:0
in  DI-01       bool modbus-tcp=di:1
in  DI-02       bool modbus-tcp=di:2
in  DI-03       bool modbus-tcp=di:3
in  DI-04       bool modbus-tcp=di:4
in  DI-05       bool modbus-tcp=di:5
in  DI-06       bool modbus-tcp=di:6
in  DI-07       bool modbus-tcp=di:7
in  DI-08       bool modbus-tcp=di:8
in  DI-09       bool modbus-tcp=di:9
in  DI-10       bool modbus-tcp=di:10
in  DI-11       bool modbus-tcp=di:11
in  DI-12       bool modbus-tcp=di:12
in  DI-13       bool modbus-tcp=di:13
in  DI-14       bool modbus-tcp=di:14
in  DI-15       bool modbus-tcp=di:15

# counters (counter mode; 0 in DI mode): input registers 16 + 2n, high word first
in  DI-00-count int  modbus-tcp=ir:16:u32
in  DI-01-count int  modbus-tcp=ir:18:u32
in  DI-02-count int  modbus-tcp=ir:20:u32
in  DI-03-count int  modbus-tcp=ir:22:u32
in  DI-04-count int  modbus-tcp=ir:24:u32
in  DI-05-count int  modbus-tcp=ir:26:u32
in  DI-06-count int  modbus-tcp=ir:28:u32
in  DI-07-count int  modbus-tcp=ir:30:u32
in  DI-08-count int  modbus-tcp=ir:32:u32
in  DI-09-count int  modbus-tcp=ir:34:u32
in  DI-10-count int  modbus-tcp=ir:36:u32
in  DI-11-count int  modbus-tcp=ir:38:u32
in  DI-12-count int  modbus-tcp=ir:40:u32
in  DI-13-count int  modbus-tcp=ir:42:u32
in  DI-14-count int  modbus-tcp=ir:44:u32
in  DI-15-count int  modbus-tcp=ir:46:u32
